{
  "name": "poshmark-wrapper",
  "version": "0.1.0",
  "private": true,
  "description": "A local, personal feed for cached Poshmark suggestions.",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:local-cache": "node server.cjs",
    "collect": "node collect.cjs",
    "collect:cloud": "node --env-file=.env.local collect.cjs --sync",
    "sync": "node --env-file=.env.local sync.cjs",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node test/browser-smoke.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
